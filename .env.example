# Copy to .env and adjust. Never commit the real .env.

# Which LLM backend to use: ollama (free, local), anthropic, or openai
PROVIDER=ollama
# Optional model override; defaults are set per provider in src/exo_agent/config.py
# MODEL=qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed for the paid providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Matches the Postgres started by `make db-up` (docker-compose.yml), which
# listens on host port 5433. If you set POSTGRES_PORT, change port= to match.
DB_DSN=dbname=exoagent user=exoagent password=exoagent host=localhost port=5433
# POSTGRES_PORT=5433

MAX_SQL_REPAIR_ATTEMPTS=2
